[Desktop Entry]
Type=Application
Name=emb-tm
GenericName=Threat modeling
Comment=Embedded-device threat modeling on MITRE EMB3D, offline
Exec=emb-tm app
Icon=emb-tm
Terminal=false
# The window `emb-tm app` opens (Chromium --app, Wayland, default profile),
# so the dock shows this entry's icon for it.
StartupWMClass=chrome-127.0.0.1__-Default
Categories=Development;
Keywords=threat model;EMB3D;TM-BOM;SBOM;security;
