[Desktop Entry]
Type=Application
Name=EMB3D Workbench
GenericName=Threat modeling
Comment=Embedded-device threat modeling on MITRE EMB3D, offline
Exec=emb3d-wb app
Icon=emb3d-wb
Terminal=false
# The window `emb3d-wb app` opens (Chromium --app, Wayland, default profile),
