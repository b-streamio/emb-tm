{
  "customTypes": [
    {
      "base": [
        "PID-13"
      ],
      "group": "Hardware",
      "hint": "Camera sensor and optics on a MIPI CSI link.",
      "name": "Image sensor module",
      "tag": "CAM",
      "threats": [
        {
          "cms": [
            {
              "desc": "Raise a tamper alarm when exposure saturates, the image goes blank or the scene changes abruptly.",
              "id": "CUM-001",
              "name": "Detect blinding and scene changes"
            }
          ],
          "desc": "An attacker blinds the sensor with a laser or bright light, covers it, or alters the scene so that intrusions are missed.",
          "id": "CUS-001",
          "name": "Optical blinding or scene manipulation"
        },
        {
          "cms": [
            {
              "desc": "Seal the enclosure and raise a tamper alarm when it is opened.",
              "id": "CUM-002",
              "name": "Tamper-evident enclosure"
            }
          ],
          "desc": "An attacker with access to the camera board injects or replays frames on the sensor link.",
          "id": "CUS-002",
          "name": "Sensor link injection"
        }
      ],
      "type": "custom-image-sensor"
    },
    {
      "base": [
        "PID-13"
      ],
      "group": "Hardware",
      "hint": "MEMS microphone on a PDM or I2S link, listening for glass break and screams.",
      "name": "Microphone (MEMS)",
      "questions": [
        {
          "default": "events",
          "id": "audio_path",
          "kind": "choice",
          "options": [
            {
              "label": "Detection events only",
              "value": "events"
            },
            {
              "label": "Audio clips or live audio",
              "pids": [
                "PID-411"
              ],
              "value": "clips"
            }
          ],
          "text": "Audio leaves the sensor as"
        }
      ],
      "tag": "MIC",
      "threats": [
        {
          "cms": [
            {
              "desc": "Raise an intrusion alarm only when a camera or another sensor confirms the audio detection.",
              "id": "CUM-003",
              "name": "Confirm audio alarms with a second sensor"
            }
          ],
          "desc": "Ultrasonic or played-back sound triggers false alarms or masks a real break-in, for example to wear out the security company's response.",
          "id": "CUS-003",
          "name": "Acoustic injection"
        },
        {
          "cms": [
            {
              "desc": "Process audio on the sensor and send only detection events; send clips only on alarm, encrypted.",
              "id": "CUM-004",
              "name": "Keep audio on the sensor"
            }
          ],
          "desc": "Room audio is captured or forwarded beyond what detection needs, exposing private conversations.",
          "id": "CUS-004",
          "name": "Eavesdropping on the premises"
        }
      ],
      "type": "custom-microphone"
    }
  ],
  "emb3d": "2.0.1",
