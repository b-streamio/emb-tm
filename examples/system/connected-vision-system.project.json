      "hint": "Camera sensor and optics on a MIPI CSI link.",
      "base": [
        "PID-13"
      ],
      "threats": [
        {
          "id": "CUS-001",
          "name": "Optical blinding or scene manipulation",
          "desc": "An attacker blinds the sensor with a laser or bright light, covers it, or alters the scene so that detections are missed or falsified.",
          "cms": [
            {
              "id": "CUM-001",
              "name": "Detect blinding and scene changes",
              "desc": "Raise an alert when exposure saturates, the image goes blank or the scene changes abruptly."
            }
          ]
        },
        {
          "id": "CUS-002",
          "name": "Sensor link injection",
          "desc": "An attacker with access to the camera board injects or replays frames on the sensor link.",
          "cms": [
            {
              "id": "CUM-002",
              "name": "Tamper-evident enclosure",
              "desc": "Seal the enclosure and detect opening so the sensor link cannot be reached unnoticed."
            }
          ]
        }
      ]
    }
  ],
